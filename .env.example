# Optional OpenAI follow-up prioritization. Both values are required.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional tracing and hosted experiments.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=devicetrail-demo

# OpenAI passage reranker. Defaults to OPENAI_MODEL when omitted.
OPENAI_RERANK_MODEL=
